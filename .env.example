# ---- S3 ----
S3_ROOT_USER=admin
S3_ROOT_PASSWORD=cambia-esta-clave

# ---- Versiones (fíjalas a las que descargaste: docker image ls) ----
REDPANDA_VERSION=latest
REDPANDA_CONSOLE_VERSION=latest
S3_VERSION=latest
AIRFLOW_VERSION=3.3.2

# ---- Airflow ----
# En Windows se deja 50000. En Linux: el resultado de `id -u`
AIRFLOW_UID=50000
AIRFLOW_DB_PASSWORD=cambia-esta-clave-de-postgres
# Genera cada una con los comandos de la guía y pégalas aquí:
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
