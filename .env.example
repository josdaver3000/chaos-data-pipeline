# Copia este archivo a .env (y añade .env a .gitignore)
S3_ROOT_USER=admin
S3_ROOT_PASSWORD=cambia-esta-clave

# Versiones: tras el primer `docker compose up`, fíjalas a la versión real
# que descargaste (docker image ls) para que el proyecto sea reproducible.
REDPANDA_VERSION=latest
REDPANDA_CONSOLE_VERSION=latest
S3_VERSION=latest
